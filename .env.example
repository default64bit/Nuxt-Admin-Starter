# Copy to .env for local development. Every variable is listed with a safe dummy value; real secrets
# live in the hosting platform's secret store, never here (ADR-0014).

# local | test | staging | production. `just` selects the dev Compose stack unless this is `production`.
NUXT_APP_ENV=local

# The one switch for infrastructure Optional pieces (ADR-0029): a comma-separated list of the Compose profiles to run.
#   media       object storage for uploads
#   monitoring  self-hosted error tracking
#   edge        HTTPS reverse proxy (production stack only)
#   backup      nightly database dump to an off-host bucket
# Default for a fresh copy: everything except monitoring. Empty runs the core stack only (app and PostgreSQL).
COMPOSE_PROFILES=media,edge,backup

# Docker stack (`just dev`, `just db-*`). The PostgreSQL container creates POSTGRES_DB and the least-privilege APP_DB_USER
# role at first start; the app and the jobs reach it as `postgres:5432` on the Compose network.
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
APP_DB_USER=app
APP_DB_PASSWORD=app
DATABASE_URL_DOCKER=postgres://app:app@postgres:5432/app
DATABASE_ADMIN_URL_DOCKER=postgres://postgres:postgres@postgres:5432/postgres
# Loopback host ports of the stack. Change them if another project already uses these, and keep the host URLs below
# and NUXT_PUBLIC_SITE_URL in step.
POSTGRES_HOST_PORT=5432
APP_HOST_PORT=3000
# Owner of files the dev containers write into the bind-mounted repository (default 1000:1000; see `id -u`, `id -g`).
# HOST_UID=1000
# HOST_GID=1000

# Host and tooling URL read by drizzle-kit and the host-side tests (the Docker stack uses the *_DOCKER URLs above).
DATABASE_URL=postgres://app:app@localhost:5432/app
# Maintenance connection that may create databases (host-side `pnpm db:ensure`; the stack uses DATABASE_ADMIN_URL_DOCKER).
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
# The Nuxt server's runtime URL. Both must target the same intended database in an environment.
NUXT_DATABASE_URL=postgres://app:app@localhost:5432/app

# Required, high-entropy secret (32+ characters). Generate one: openssl rand -hex 32
NUXT_SESSION_PASSWORD=change-me-to-a-random-secret-of-at-least-32-characters

# The Default admin, created once by the seed (`just db-seed`). Leave the phone empty and the seed warns, skips and
# retries on the next run. Later changes to these values never alter the existing account. Personal data: keep it
# in your local .env only.
DEFAULT_ADMIN_PHONE=
DEFAULT_ADMIN_GIVEN_NAME=
DEFAULT_ADMIN_FAMILY_NAME=

# The public site URL.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Edge proxy (Optional piece, profile `edge`; production stack only). Point SITE_DOMAIN (an apex without www.; Caddy also
# serves www.<SITE_DOMAIN> as a redirect) at this server with ports 80 and 443 reachable: Caddy obtains Let's Encrypt
# certificates by itself. With `edge` Off the lines below are ignored and your own proxy talks to APP_HOST_PORT.
# In production NUXT_PUBLIC_SITE_URL must be exactly https://<SITE_DOMAIN> (checked by scripts/ops/edge-guards.sh).
SITE_DOMAIN=app.example.com
ACME_EMAIL=admin@example.com
# First issuance only, to avoid Let's Encrypt rate limits while DNS is being sorted out; remove afterwards.
# CADDY_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
CADDY_ACME_CA=

# Public origin that serves media (an Optional piece); joins the CSP image sources. Empty = none.
NUXT_PUBLIC_MEDIA_BASE_URL=
# Browser DSN for error tracking (an Optional piece); adds its origin and CSP report endpoint. Empty = not configured.
NUXT_PUBLIC_GLITCHTIP_DSN=

# GlitchTip error tracking (the `monitoring` profile; an Optional piece, docs/optional-pieces/glitchtip.md). Everything below
# is ignored while `monitoring` is not in COMPOSE_PROFILES. GlitchTip gets its own database and role on the shared
# PostgreSQL, created by `monitoring-db-init`. The password must be URL-safe and at least 24 characters.
GLITCHTIP_DB_NAME=glitchtip
GLITCHTIP_DB_USER=glitchtip_app
GLITCHTIP_DB_PASSWORD=replace-with-url-safe-random-secret-at-least-24-characters
GLITCHTIP_SECRET_KEY=replace-with-a-separate-random-secret
GLITCHTIP_HOST_PORT=8000
GLITCHTIP_DOMAIN=http://127.0.0.1:8000
GLITCHTIP_ALLOWED_HOSTS=localhost,127.0.0.1,glitchtip,errors.example.com
GLITCHTIP_FROM_EMAIL=errors@example.com
GLITCHTIP_EVENT_RETENTION_DAYS=90
# Production only: the hostname the edge serves GlitchTip on (set GLITCHTIP_DOMAIN to https://<ERRORS_DOMAIN> and add the
# hostname to GLITCHTIP_ALLOWED_HOSTS). Leave empty while `monitoring` is Off: the edge then serves no errors host, and
# scripts/ops/edge-guards.sh requires a real value only when `monitoring` is listed.
ERRORS_DOMAIN=
# Server-side DSN of the project (may use the internal host, e.g. http://<key>@glitchtip:8000/1). Empty falls back to
# NUXT_PUBLIC_GLITCHTIP_DSN; with both empty no error is captured or sent.
NUXT_GLITCHTIP_SERVER_DSN=

# Private object storage (an Optional piece). Leave all empty to run without it: readiness skips it.
NUXT_S3_ENDPOINT=
NUXT_S3_REGION=us-east-1
NUXT_S3_ACCESS_KEY=
NUXT_S3_SECRET_KEY=
NUXT_S3_PRIVATE_BUCKET=
NUXT_S3_PUBLIC_BUCKET=

# Integration tests only: a role that may create and drop databases. Each test file uses its own throwaway database.
# TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
