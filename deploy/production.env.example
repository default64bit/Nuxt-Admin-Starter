# Production environment template (placeholders only; never put real values in this file or anywhere in GitHub).
# On the VPS: cp deploy/production.env.example /srv/nuxt-admin-starter/shared/.env && chmod 600 /srv/nuxt-admin-starter/shared/.env
# then replace every placeholder (change-me-*, replace-with-*, *.example.com, <...>). Production refuses placeholders.
# Dotenv values are not variable-expanded: repeat a password inside a URL by hand and keep both copies identical.
# Per-run values are NOT stored here: DEPLOY_APPROVED=YES is passed by whoever runs the deploy (the poller does it) and
# APP_IMAGE_TAG is set by `just deploy` from the release SHA.
# Coverage of this file is enforced by tests/unit/ops/production-env-template.test.ts.

# --- Environment, Optional pieces and release state --------------------------------------------------------------
NUXT_APP_ENV=production
# The one list of infrastructure Optional pieces to run (ADR-0029): media, monitoring, edge, backup. A piece that is not
# listed is skipped by every recipe and by the release guards. Add monitoring to run GlitchTip (then fill its section).
COMPOSE_PROFILES=media,edge,backup
# Where `just deploy`, `rollback`, `release-status` and the automatic deployment keep release state.
DEPLOY_STATE_DIR=/srv/nuxt-admin-starter/shared/.deploy
# Optional: registry path of the images (default ghcr.io/default64bit/nuxt-admin-starter). Also names the GitHub
# repository whose Deployments the automatic deployment polls (the path without the registry host).
# APP_IMAGE_REPO=ghcr.io/<owner>/<repo>

# --- Domains, public URLs and certificates (edge proxy) ----------------------------------------------------------
# Hostnames whose A records point directly at this VPS, CDN or DNS proxy off: Caddy obtains certificates with
# HTTP-01/TLS-ALPN-01. SITE_DOMAIN is the apex without www. (Caddy redirects www. to it). Ignored while `edge` is not
# listed (your own proxy then talks to APP_HOST_PORT); then only NUXT_PUBLIC_SITE_URL matters.
SITE_DOMAIN=app.example.com
# Needed while `media` is listed (Caddy serves the media host).
MEDIA_DOMAIN=media.example.com
# Let's Encrypt account contact (expiry notices).
ACME_EMAIL=admin@example.com
# Must be exactly https://<SITE_DOMAIN> while `edge` is listed.
NUXT_PUBLIC_SITE_URL=https://app.example.com
# Public origin that serves media, joins the CSP image sources: https://<MEDIA_DOMAIN>/<NUXT_S3_PUBLIC_BUCKET>. Empty = none.
NUXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com/change-me-public-bucket
# First certificate issuance ONLY: uncomment to use the Let's Encrypt STAGING directory (untrusted test certificates, no
# rate-limit risk), deploy, check `docker compose logs caddy`, then comment it out again and deploy to get real
# certificates. Left unset, Caddy uses the production directory. `just release-status` warns while this is set.
# CADDY_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# --- PostgreSQL --------------------------------------------------------------------------------------------------
POSTGRES_HOST_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
# Cluster superuser password: generate randomly (URL-safe). Keep the copy inside DATABASE_ADMIN_URL_DOCKER identical.
POSTGRES_PASSWORD=change-me-postgres-superuser-password
# Runtime application role (least privilege). Keep the copy inside DATABASE_URL_DOCKER identical.
APP_DB_USER=app
APP_DB_PASSWORD=change-me-app-password
DATABASE_URL_DOCKER=postgresql://app:change-me-app-password@postgres:5432/app
DATABASE_ADMIN_URL_DOCKER=postgresql://postgres:change-me-postgres-superuser-password@postgres:5432/postgres

# --- Application secrets (generate each with: openssl rand -base64 48) ------------------------------------------
NUXT_SESSION_PASSWORD=replace-with-a-random-secret-at-least-32-characters-long
NUXT_IP_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# --- First administrator -----------------------------------------------------------------------------------------
# Default admin created once by the seed. Blank skips it with a warning; set it and deploy again.
DEFAULT_ADMIN_PHONE=
DEFAULT_ADMIN_GIVEN_NAME=
DEFAULT_ADMIN_FAMILY_NAME=

# --- Sign-in codes by SMS (Kavenegar) ----------------------------------------------------------------------------
# Production needs a real provider. The key comes from the Kavenegar panel; allowlist only the VPS address there.
NUXT_SMS_PROVIDER=kavenegar
# Temporary owner opt-in: set NUXT_SMS_PROVIDER=mock AND this to the literal true to start without the Kavenegar key and
# templates. Nobody can sign in while it is on. Leave blank for a real launch.
NUXT_SMS_ALLOW_MOCK_IN_PRODUCTION=
NUXT_KAVENEGAR_API_KEY=replace-with-kavenegar-api-key
NUXT_KAVENEGAR_TIMEOUT_MS=10000
# Verify/lookup template names created in the Kavenegar panel (English letters only; see the bootstrap checklist).
NUXT_SMS_TEMPLATE_OTP_FA=change-me-otp-fa
NUXT_SMS_TEMPLATE_OTP_EN=

# --- Private object storage (media piece; leave empty to run without it) -----------------------------------------
NUXT_S3_REGION=us-east-1
NUXT_S3_ACCESS_KEY=
NUXT_S3_SECRET_KEY=
NUXT_S3_PRIVATE_BUCKET=
NUXT_S3_PUBLIC_BUCKET=

# --- Error tracking (GlitchTip; read only while `monitoring` is listed in COMPOSE_PROFILES) ---------------------
# Hostname the edge serves GlitchTip on; a real value is required only while `monitoring` is listed.
ERRORS_DOMAIN=
GLITCHTIP_HOST_PORT=8000
GLITCHTIP_DB_NAME=glitchtip
GLITCHTIP_DB_USER=glitchtip_app
# URL-safe random password, at least 24 characters.
GLITCHTIP_DB_PASSWORD=change-me-glitchtip-db-password
GLITCHTIP_SECRET_KEY=replace-with-a-separate-random-secret
# https://<ERRORS_DOMAIN>, and that hostname (plus glitchtip) in the allowed hosts.
GLITCHTIP_DOMAIN=http://127.0.0.1:8000
GLITCHTIP_ALLOWED_HOSTS=errors.example.com,glitchtip
GLITCHTIP_FROM_EMAIL=errors@example.com
GLITCHTIP_EVENT_RETENTION_DAYS=90
# DSNs from the GlitchTip project settings once it is running; blank disables reporting without affecting the app.
NUXT_PUBLIC_GLITCHTIP_DSN=
NUXT_GLITCHTIP_SERVER_DSN=

# --- Published ports (loopback only; the edge proxy is the sole public ingress) ---------------------------------
APP_HOST_PORT=3000
